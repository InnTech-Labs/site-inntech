---
/**
 * Chamada final de cada página, sobre o padrão nn do kit.
 * Por padrão leva ao pedido de demonstração (CTA principal do site).
 */
import { site } from '../lib/site';

interface Props {
  titulo: string;
  texto?: string;
  rotulo?: string;
  href?: string;
}
const { titulo, texto, rotulo = site.cta.rotulo, href = site.cta.href } = Astro.props;
---

<section class="cta">
  <div class="container cta__interno">
    <div class="cta__texto">
      <h2>{titulo}</h2>
      {texto && <p class="lead">{texto}</p>}
    </div>
    <a class="botao cta__botao" href={href}>{rotulo}</a>
  </div>
</section>

<style>
  .cta {
    position: relative;
    isolation: isolate;
    padding-block: var(--esp-secao);
    border-top: 1px solid var(--cinza);
    background: var(--preto);
    overflow: hidden;
  }
  .cta::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: var(--fundo-padrao-nn);
    background-size: 840px auto;
    background-position: left center;
  }
  .cta__interno {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--esp-6);
  }
  .cta__texto {
    max-width: 40rem;
  }
  .cta h2 {
    font-size: var(--titulo-mega);
    margin-bottom: var(--esp-3);
  }
  .cta .lead {
    margin: 0;
    color: var(--claro);
  }
</style>
