---
/**
 * Formulário geral de contato (Netlify Forms + honeypot).
 * Notificação: Netlify → Forms → contato → Form notifications → contato@inntechlabs.com.br.
 * LGPD: pede só o necessário, com aceite obrigatório.
 */
const nome = 'contato';
---

<form class="formulario" name={nome} method="POST" action="/obrigado" data-netlify="true" netlify-honeypot="campo-robo">
  <input type="hidden" name="form-name" value={nome} />
  <input type="hidden" name="pagina" value={Astro.url.pathname} />
  <p class="visualmente-oculto" aria-hidden="true">
    <label>Não preencha: <input name="campo-robo" tabindex="-1" autocomplete="off" /></label>
  </p>

  <div class="formulario__linha">
    <div class="campo">
      <label for="c-nome">Nome</label>
      <input id="c-nome" name="nome" type="text" autocomplete="name" required />
    </div>
    <div class="campo">
      <label for="c-empresa">Empresa <span class="opcional">(opcional)</span></label>
      <input id="c-empresa" name="empresa" type="text" autocomplete="organization" />
    </div>
  </div>

  <div class="formulario__linha">
    <div class="campo">
      <label for="c-email">E-mail</label>
      <input id="c-email" name="email" type="email" autocomplete="email" inputmode="email" required />
    </div>
    <div class="campo">
      <label for="c-telefone">Telefone ou WhatsApp <span class="opcional">(opcional)</span></label>
      <input id="c-telefone" name="telefone" type="tel" autocomplete="tel" inputmode="tel" />
    </div>
  </div>

  <div class="campo">
    <label for="c-mensagem">Mensagem</label>
    <textarea id="c-mensagem" name="mensagem" rows="5" required></textarea>
  </div>

  <label class="consentimento">
    <input type="checkbox" name="aceite_lgpd" value="sim" required />
    <span>
      Concordo com o uso dos meus dados para responder a este contato, conforme a{' '}
      <a href="/politica-de-privacidade">política de privacidade</a>.
    </span>
  </label>

  <div class="acoes">
    <button class="botao botao--claro" type="submit">Enviar mensagem</button>
  </div>
</form>
