---
/**
 * Formulário "Solicitar acesso" à área de demonstração (Netlify Forms + honeypot).
 *
 * - Notificação: configurar na Netlify (Forms → solicitar-acesso-demo → Form notifications)
 *   para comercial@inntechlabs.com.br. Quando a área de demo estiver no ar, um webhook
 *   da Netlify envia cada pedido para ela (o pedido nunca se perde, mesmo se a demo cair).
 * - E-mail gratuito (gmail, hotmail…) não é bloqueado: o campo oculto "email_gratuito"
 *   sinaliza para o Leo decidir.
 * - Campos obrigatórios só os essenciais: nome, empresa, e-mail e área. "O que você quer ver"
 *   e mensagem são opcionais (pedido do Leo: o mais fácil possível; sem cargo e sem telefone).
 * - LGPD: aceite obrigatório, com link para a política de privacidade.
 */
interface Props {
  areas: string[];
  interesses: string[];
}
const { areas, interesses } = Astro.props;
const nome = 'solicitar-acesso-demo';
---

<form
  id="form-demo"
  class="formulario"
  name={nome}
  method="POST"
  action="/pedido-recebido"
  data-netlify="true"
  netlify-honeypot="campo-robo"
>
  <input type="hidden" name="form-name" value={nome} />
  <input type="hidden" name="email_gratuito" value="não verificado" />
  <p class="visualmente-oculto" aria-hidden="true">
    <label>Não preencha: <input name="campo-robo" tabindex="-1" autocomplete="off" /></label>
  </p>

  <div class="formulario__linha">
    <div class="campo">
      <label for="d-nome">Nome</label>
      <input id="d-nome" name="nome" type="text" autocomplete="name" required />
    </div>
    <div class="campo">
      <label for="d-empresa">Empresa</label>
      <input id="d-empresa" name="empresa" type="text" autocomplete="organization" required />
    </div>
  </div>

  <div class="formulario__linha">
    <div class="campo">
      <label for="d-email">E-mail corporativo</label>
      <input id="d-email" name="email" type="email" autocomplete="email" inputmode="email" required />
    </div>
    <div class="campo">
      <label for="d-area">Área</label>
      <select id="d-area" name="area" required>
        <option value="">Selecione</option>
        {areas.map((area) => <option value={area}>{area}</option>)}
      </select>
    </div>
  </div>

  <fieldset class="grupo">
    <legend>O que você quer ver <span class="opcional">(opcional)</span></legend>
    <div class="opcoes">
      {interesses.map((interesse) => (
        <label class="opcao">
          <input type="checkbox" name="interesse[]" value={interesse} />
          <span>{interesse}</span>
        </label>
      ))}
    </div>
  </fieldset>

  <div class="campo">
    <label for="d-mensagem">Mensagem <span class="opcional">(opcional)</span></label>
    <textarea id="d-mensagem" name="mensagem" rows="4"></textarea>
  </div>

  <label class="consentimento">
    <input type="checkbox" name="aceite_lgpd" value="sim" required />
    <span>
      Concordo com o uso dos meus dados para análise do pedido, envio do acesso e contato da InnTech Labs,
      conforme a <a href="/politica-de-privacidade">política de privacidade</a>.
    </span>
  </label>

  <div class="acoes">
    <button class="botao" type="submit">Solicitar acesso</button>
    <p class="formulario__nota">Prefira o e-mail corporativo: ele agiliza a análise.</p>
  </div>
</form>

<script>
  // Domínios de e-mail gratuito: sinaliza no pedido, sem bloquear.
  const GRATUITOS = [
    'gmail.com', 'googlemail.com', 'hotmail.com', 'hotmail.com.br', 'outlook.com', 'outlook.com.br',
    'live.com', 'msn.com', 'yahoo.com', 'yahoo.com.br', 'ymail.com', 'icloud.com', 'me.com',
    'bol.com.br', 'uol.com.br', 'terra.com.br', 'ig.com.br', 'globo.com', 'globomail.com',
    'aol.com', 'gmx.com', 'proton.me', 'protonmail.com', 'zipmail.com.br',
  ];

  const form = document.querySelector<HTMLFormElement>('#form-demo');
  if (form) {
    const email = form.querySelector<HTMLInputElement>('input[name="email"]')!;
    const sinal = form.querySelector<HTMLInputElement>('input[name="email_gratuito"]')!;

    form.addEventListener('submit', () => {
      const dominio = email.value.trim().toLowerCase().split('@')[1] || '';
      sinal.value = GRATUITOS.includes(dominio) ? 'SIM — e-mail gratuito, verificar' : 'não';
    });
  }
</script>
