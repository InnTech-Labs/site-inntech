---
/**
 * Rodapé: régua de chanfros do kit, logo, navegação, contatos, redes e linha legal.
 * Rede sem link (ex.: LinkedIn) e CNPJ vazio ficam ocultos até serem preenchidos em site.json.
 */
import { site, redesAtivas, linkWhatsapp, linkTelefone } from '../lib/site';

const { contato } = site;
const whatsapp = linkWhatsapp('Rodapé');
const telefone = linkTelefone();
const ano = new Date().getFullYear();
---

<footer class="rodape">
  <div class="container">
    <img class="rodape__regua" src="/marca/regua-chanfros.svg" alt="" width="294" height="14" />

    <div class="rodape__grade">
      <div class="rodape__marca">
        <img src={site.logo} alt={site.nome} width="168" height="60" />
        <p>{site.descricao}</p>
      </div>

      <nav aria-label="Rodapé">
        <h2 class="rotulo">Navegação</h2>
        <ul role="list">
          {site.navegacao.map((item) => <li><a href={item.href}>{item.rotulo}</a></li>)}
        </ul>
      </nav>

      <div>
        <h2 class="rotulo">Contato</h2>
        <ul role="list">
          {whatsapp && <li><a href={whatsapp} target="_blank" rel="noopener" data-evento="clique_whatsapp">WhatsApp</a></li>}
          {telefone && <li><a href={telefone}>{contato.telefone}</a></li>}
          <li><a href={`mailto:${contato.email}`} data-evento="clique_email">{contato.email}</a></li>
        </ul>
      </div>

      {redesAtivas().length > 0 && (
        <div>
          <h2 class="rotulo">Redes</h2>
          <ul role="list">
            {redesAtivas().map((rede) => (
              <li><a href={rede.url} target="_blank" rel="noopener">{rede.nome}</a></li>
            ))}
          </ul>
        </div>
      )}
    </div>

    <div class="rodape__legal">
      <p>
        {site.nome} · {site.razaoSocial}{site.cnpj && ` · CNPJ ${site.cnpj}`} · © {ano}
      </p>
      <ul role="list">
        <li><a href="/politica-de-privacidade">Política de privacidade</a></li>
        <li><a href="/politica-de-cookies">Política de cookies</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .rodape {
    background: var(--preto);
    border-top: 1px solid var(--cinza);
    padding-top: var(--esp-7);
    font-size: var(--texto-sm);
  }
  .rodape__regua {
    width: 196px;
    height: auto;
    margin-bottom: var(--esp-7);
  }
  .rodape__grade {
    display: grid;
    gap: var(--esp-6);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
  }
  .rodape__marca {
    grid-column: 1 / -1;
  }
  .rodape__marca img {
    width: 150px;
    height: auto;
    margin-bottom: var(--esp-4);
  }
  .rodape__marca p {
    color: var(--claro-suave);
    max-width: 20rem;
    margin: 0;
  }
  .rodape h2 {
    margin-bottom: var(--esp-3);
  }
  .rodape ul {
    display: grid;
    gap: var(--esp-2);
  }
  .rodape a {
    color: var(--claro-suave);
    text-decoration: none;
  }
  .rodape a:hover {
    color: var(--claro);
    text-decoration: underline;
    text-decoration-color: var(--vermelho);
  }
  .rodape__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--esp-3) var(--esp-5);
    margin-top: var(--esp-7);
    padding-block: var(--esp-5) calc(var(--esp-5) + 4.5rem); /* espaço para o botão flutuante */
    border-top: 1px solid var(--grafite);
    color: var(--claro-rotulo);
    font-family: var(--fonte-mono);
    font-size: var(--texto-rotulo);
    letter-spacing: 0.04em;
  }
  .rodape__legal p {
    margin: 0;
  }
  .rodape__legal ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--esp-2) var(--esp-5);
  }
  .rodape__legal a {
    color: var(--claro-rotulo);
  }
  @media (min-width: 900px) {
    .rodape__grade {
      grid-template-columns: 2fr 1fr 1.4fr 1fr;
    }
    .rodape__marca {
      grid-column: auto;
    }
    .rodape__legal {
      padding-bottom: var(--esp-5);
    }
  }
</style>
