---
/**
 * Ícones geométricos da InnTech Labs: traço reto, cortes a 45°, sem cantos arredondados.
 * Desenhados em grade de 32 px. Cor: herda currentColor.
 * Uso: <Icone nome="simulacao-3d" tamanho={40} />
 */
interface Props {
  nome:
    | 'simulacao-3d'
    | 'conteudo-interativo'
    | 'gamificacao'
    | 'dialogo'
    | 'plataforma'
    | 'realidade-virtual'
    | 'seta';
  tamanho?: number;
  class?: string;
}
const { nome, tamanho = 40, class: classe } = Astro.props;
---

<svg
  class:list={['icone', classe]}
  viewBox="0 0 32 32"
  width={tamanho}
  height={tamanho}
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linejoin="miter"
  stroke-linecap="square"
  aria-hidden="true"
  focusable="false"
>
  {nome === 'simulacao-3d' && (
    <>
      <path d="M16 3 28 9.5v13L16 29 4 22.5v-13Z" />
      <path d="M4 9.5 16 16l12-6.5M16 16v13" />
    </>
  )}
  {nome === 'conteudo-interativo' && (
    <>
      <path d="M7 5h22v15l-3 3H3V9Z" />
      <path d="m15 13 9 3.5-4 1.5 3 4-1.8 1.4-3-4-3 3Z" fill="currentColor" stroke="none" />
      <path d="M11 27h10" />
    </>
  )}
  {nome === 'gamificacao' && (
    <>
      <path d="M8 9h16l5 5v7l-4 4h-3l-3-3h-6l-3 3H7l-4-4v-7Z" />
      <path d="M10 13v6M7 16h6" />
      <path d="M21 14h.01M24 17h.01" stroke-width="3" />
    </>
  )}
  {nome === 'dialogo' && (
    <>
      <path d="M6 4h16v10l-3 3h-6l-5 4v-4H3V7Z" />
      <path d="M26 11h3v12h-3v4l-5-4h-6l-2-2" />
    </>
  )}
  {nome === 'plataforma' && (
    <>
      <path d="M16 4 29 10l-13 6-13-6Z" />
      <path d="m3 16 13 6 13-6M3 22l13 6 13-6" />
    </>
  )}
  {nome === 'realidade-virtual' && (
    <>
      <path d="M6 10h20l4 4v6l-3 3h-6l-3-3h-4l-3 3H5l-3-3v-6Z" />
      <path d="M8 15h4M20 15h4" />
    </>
  )}
  {nome === 'seta' && <path d="M6 16h18M17 9l7 7-7 7" />}
</svg>
