---
/**
 * Botão flutuante de WhatsApp em todas as páginas. A mensagem pré-preenchida
 * identifica a página de origem. Círculo claro: destaca no fundo escuro sem
 * criar mais um ponto vermelho (regra da marca).
 */
import { linkWhatsapp } from '../lib/site';

interface Props {
  paginaTitulo?: string;
}
const link = linkWhatsapp(Astro.props.paginaTitulo);
---

{link && (
  <a class="whatsapp" href={link} target="_blank" rel="noopener" aria-label="Conversar pelo WhatsApp" data-evento="clique_whatsapp">
    <svg viewBox="0 0 32 32" width="26" height="26" aria-hidden="true" focusable="false">
      <path
        fill="currentColor"
        d="M16 3C8.8 3 3 8.7 3 15.8c0 2.5.7 4.9 2 7L3 29l6.4-2c2 1.1 4.3 1.7 6.6 1.7 7.2 0 13-5.7 13-12.8S23.2 3 16 3zm0 23.4c-2.1 0-4.1-.6-5.9-1.7l-.4-.2-3.8 1.2 1.2-3.7-.3-.4a10.5 10.5 0 0 1-1.7-5.8C5.1 9.9 10 5.2 16 5.2s10.9 4.7 10.9 10.6S22 26.4 16 26.4zm6-7.9c-.3-.2-1.9-1-2.2-1.1-.3-.1-.5-.2-.7.2-.2.3-.8 1-1 1.2-.2.2-.4.2-.7.1-.3-.2-1.4-.5-2.6-1.6-1-.9-1.6-1.9-1.8-2.2-.2-.3 0-.5.1-.7l.5-.6c.2-.2.2-.4.3-.6.1-.2 0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.1-1.2 2.7s1.2 3.2 1.4 3.4c.2.2 2.4 3.6 5.8 5 .8.4 1.4.6 1.9.7.8.3 1.5.2 2.1.1.6-.1 1.9-.8 2.2-1.5.3-.7.3-1.4.2-1.5-.1-.2-.3-.3-.6-.4z"
      />
    </svg>
  </a>
)}

<style>
  .whatsapp {
    position: fixed;
    right: var(--esp-4);
    bottom: var(--esp-4);
    z-index: 40;
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%; /* o círculo é o botão de avanço do kit: único arredondado permitido */
    background: var(--claro);
    color: var(--preto);
    box-shadow: var(--relevo) var(--relevo) 0 var(--cinza);
    transition: transform var(--transicao), box-shadow var(--transicao), background var(--transicao);
  }
  .whatsapp:hover {
    background: var(--branco-quente);
    color: var(--preto);
  }
  .whatsapp:active {
    transform: translate(3px, 3px);
    box-shadow: 1px 1px 0 var(--cinza);
  }
</style>
