---
/**
 * Aviso de cookies (LGPD) e medição de conversões.
 *
 * - Só aparece se houver Google Analytics configurado em site.json (analytics.ga4).
 * - O Analytics só carrega DEPOIS que a pessoa aceita. Sem aceite, nenhum evento é enviado.
 * - Conversões medidas (nomes dos eventos no GA4):
 *     clique_whatsapp · clique_email · clique_entrar_demo  → links com data-evento="..."
 *     pedido_demo · contato_enviado · aviso_innloco_campo  → páginas de confirmação (data-evento-pagina no <main>)
 * - Links com data-preferencias-cookies reabrem o aviso (usado na política de cookies).
 */
import { site } from '../lib/site';
const ga4 = site.analytics.ga4;
---

{ga4 && (
  <div class="cookies" data-ga4={ga4} hidden role="region" aria-label="Aviso de cookies">
    <p>
      Usamos cookies de análise para entender como o site é usado e melhorá-lo.
      Saiba mais na <a href="/politica-de-cookies">política de cookies</a>.
    </p>
    <div class="cookies__acoes">
      <button type="button" class="botao botao--grafite" data-escolha="recusado">Recusar</button>
      <button type="button" class="botao botao--claro" data-escolha="aceito">Aceitar</button>
    </div>
  </div>
)}

<script>
  const CHAVE = 'consentimento-cookies';
  const aviso = document.querySelector<HTMLElement>('.cookies');
  const w = window as any;

  function ler(): string | null {
    try {
      return localStorage.getItem(CHAVE);
    } catch {
      return null;
    }
  }
  function salvar(valor: string) {
    try {
      localStorage.setItem(CHAVE, valor);
    } catch {
      /* navegador sem armazenamento: a escolha vale só nesta visita */
    }
  }

  function enviarEvento(nome: string, parametros: Record<string, string> = {}) {
    if (typeof w.gtag === 'function') w.gtag('event', nome, parametros);
  }

  function carregarAnalytics(id: string) {
    if (w.gtag) return;
    const script = document.createElement('script');
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${id}`;
    document.head.appendChild(script);
    w.dataLayer = w.dataLayer || [];
    w.gtag = function () {
      w.dataLayer.push(arguments);
    };
    w.gtag('js', new Date());
    w.gtag('config', id);

    // Conversão de página (ex.: chegou na confirmação do pedido de demo).
    const eventoPagina = document.querySelector<HTMLElement>('[data-evento-pagina]')?.dataset.eventoPagina;
    if (eventoPagina) enviarEvento(eventoPagina);
  }

  // Cliques que contam como conversão.
  document.addEventListener('click', (evento) => {
    const alvo = (evento.target as HTMLElement).closest<HTMLElement>('[data-evento]');
    if (alvo) enviarEvento(alvo.dataset.evento!, { pagina: location.pathname });
  });

  if (aviso) {
    const id = aviso.dataset.ga4!;
    const escolha = ler();
    if (escolha === 'aceito') carregarAnalytics(id);
    if (!escolha) aviso.hidden = false;

    aviso.querySelectorAll<HTMLButtonElement>('[data-escolha]').forEach((botao) => {
      botao.addEventListener('click', () => {
        const valor = botao.dataset.escolha!;
        salvar(valor);
        aviso.hidden = true;
        if (valor === 'aceito') carregarAnalytics(id);
      });
    });

    document.querySelectorAll('[data-preferencias-cookies]').forEach((link) => {
      link.addEventListener('click', (evento) => {
        evento.preventDefault();
        aviso.hidden = false;
        aviso.querySelector<HTMLButtonElement>('[data-escolha="aceito"]')?.focus();
      });
    });
  }
</script>

<style>
  .cookies {
    position: fixed;
    left: var(--esp-4);
    right: var(--esp-4);
    bottom: var(--esp-4);
    z-index: 60;
    max-width: 34rem;
    padding: var(--esp-5);
    background: var(--grafite);
    border: 1px solid var(--cinza);
    font-size: var(--texto-sm);
    color: var(--claro-suave);
  }
  .cookies[hidden] {
    display: none;
  }
  .cookies__acoes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--esp-3);
    justify-content: flex-end;
  }
</style>
