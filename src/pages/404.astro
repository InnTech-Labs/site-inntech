---
import Base from '../layouts/Base.astro';
import PaginaSimples from '../components/PaginaSimples.astro';
import { site } from '../lib/site';
import paginas from '../content/pt/paginas.json';
const p = paginas.erro404;
---

<Base titulo={p.seo.titulo} descricao={p.seo.descricao} semIndexar>
  <PaginaSimples rotulo={p.rotulo} titulo={p.titulo} texto={p.texto}>
    <div class="acoes">
      <a class="botao botao--claro" href="/">{p.voltar}</a>
      <a class="botao" href={site.cta.href}>{site.cta.rotulo}</a>
    </div>
  </PaginaSimples>
</Base>
