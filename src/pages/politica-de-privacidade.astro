---
/**
 * Política de privacidade. O texto fica em src/content/legal/politica-de-privacidade.md.
 * Ao mudar o texto, atualize "atualizadoEm" no topo do arquivo .md.
 * Pendente: incluir o CNPJ da INN TECH LTDA quando for informado.
 */
import Base from '../layouts/Base.astro';
import PaginaLegal from '../components/PaginaLegal.astro';
import { Content, frontmatter } from '../content/legal/politica-de-privacidade.md';
---

<Base
  titulo="Política de privacidade"
  descricao="Como a InnTech Labs trata os dados pessoais de quem visita o site, fala com a gente ou usa a área de demonstração."
>
  <PaginaLegal titulo="Política de privacidade" atualizadoEm={frontmatter.atualizadoEm}>
    <Content />
  </PaginaLegal>
</Base>
