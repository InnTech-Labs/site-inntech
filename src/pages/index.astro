---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import MapaOperacao from '../components/MapaOperacao.astro';
import Icone from '../components/Icone.astro';
import Ficha from '../components/Ficha.astro';
import Passos from '../components/Passos.astro';
import CTA from '../components/CTA.astro';
import { site } from '../lib/site';
import home from '../content/pt/home.json';
import solucoes from '../content/pt/solucoes.json';
import innloco from '../content/pt/innloco.json';

const entregas = solucoes.itens.filter((item) => item.ativo).slice(0, 4);
---

<Base titulo={site.nome} tituloSeo={home.seo.titulo} descricao={home.seo.descricao}>
  <Hero
    titulo={home.hero.titulo}
    subtitulo={home.hero.subtitulo}
    video={home.hero.video}
    acoes={[
      { rotulo: home.hero.acaoPrincipal, href: site.cta.href },
      { rotulo: home.hero.acaoSecundaria, href: '/solucoes', estilo: 'grafite' },
    ]}
  >
    <MapaOperacao slot="visual" />
  </Hero>

  <section class="secao entregas" aria-labelledby="entregas-titulo">
    <div class="container">
      <header class="secao__cabecalho">
        <h2 id="entregas-titulo">{home.entregamos.titulo}</h2>
      </header>
      <ul class="entregas__grade" role="list">
        {entregas.map((item) => (
          <li>
            <a class="cartao painel" href={`/solucoes#${item.id}`}>
              <Icone nome={item.icone as any} tamanho={44} class="cartao__icone" />
              <h3 class="cartao__titulo">{item.nomeCurto}</h3>
              <p>{item.linha}</p>
              <span class="cartao__avanco" aria-hidden="true"><Icone nome="seta" tamanho={18} /></span>
              <span class="visualmente-oculto">{home.entregamos.rotuloLink}: {item.nome}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="secao secao--painel destaque" aria-labelledby="destaque-titulo">
    <div class="container destaque__grade">
      <div class="destaque__texto">
        <span class="tag tag--vermelho">{home.innloco.status}</span>
        <h2 id="destaque-titulo" class="destaque__titulo">{home.innloco.titulo}</h2>
        <p class="destaque__chamada">{home.innloco.chamada}</p>
        <p class="lead">{home.innloco.texto}</p>
        <div class="acoes">
          <a class="botao botao--claro" href="/innloco">{home.innloco.acaoPrincipal}</a>
          <a class="link" href="/demonstracao">{home.innloco.acaoSecundaria}</a>
        </div>
      </div>
      <Ficha
        nome={innloco.ficha.nome}
        atributos={innloco.ficha.atributos}
        proximo={{ nome: innloco.campo.titulo, status: innloco.campo.status, texto: innloco.campo.texto }}
      />
    </div>
  </section>

  <section class="secao secao--vinho manifesto" aria-label="Por que formato importa">
    <div class="container">
      <p class="manifesto__frase">{home.manifesto.frase}</p>
      <p class="manifesto__virada">{home.manifesto.virada}</p>
    </div>
  </section>

  <section class="secao" aria-labelledby="como-titulo">
    <div class="container">
      <header class="secao__cabecalho">
        <h2 id="como-titulo">{home.comoFunciona.titulo}</h2>
      </header>
      <Passos passos={home.comoFunciona.passos} />
    </div>
  </section>

  <section class="secao secao--painel" aria-labelledby="quem-titulo">
    <div class="container">
      <header class="secao__cabecalho">
        <h2 id="quem-titulo">{home.paraQuem.titulo}</h2>
      </header>
      <dl class="publicos">
        {home.paraQuem.itens.map((item) => (
          <div class="publico">
            <dt class="rotulo">{item.area}</dt>
            <dd>{item.dor}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="secao" aria-labelledby="porque-titulo">
    <div class="container porque">
      <header class="secao__cabecalho porque__cabecalho">
        <h2 id="porque-titulo">{home.porQue.titulo}</h2>
      </header>
      <ul class="porque__grade" role="list">
        {home.porQue.itens.map((item) => (
          <li class="moldura moldura--vazada porque__item">
            <h3>{item.titulo}</h3>
            <p>{item.texto}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CTA titulo={home.cta.titulo} texto={home.cta.texto} />
</Base>

<style>
  /* O que entregamos */
  .entregas__grade {
    display: grid;
    gap: var(--esp-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15.5rem), 1fr));
  }
  .entregas__grade li {
    display: flex;
  }
  .cartao {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--esp-3);
    width: 100%;
    min-height: 15.5rem;
    padding: var(--esp-6) var(--esp-5) var(--esp-5);
    color: var(--claro);
    text-decoration: none;
    transition: background var(--transicao);
  }
  .cartao:hover {
    background: var(--cinza);
  }
  .cartao:hover .cartao__avanco {
    background: var(--vermelho);
    border-color: var(--vermelho);
    color: var(--branco-quente);
  }
  .cartao :global(.cartao__icone) {
    color: var(--claro);
    margin-bottom: var(--esp-3);
  }
  .cartao__titulo {
    font-size: var(--titulo-4);
    margin: 0;
  }
  .cartao p {
    margin: 0;
    color: var(--claro-suave);
  }
  .cartao__avanco {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    margin-top: auto;
    border: 1px solid var(--cinza);
    border-radius: 50%;
    color: var(--claro);
    transition: background var(--transicao), border-color var(--transicao), color var(--transicao);
  }
  .cartao:focus-visible {
    outline-offset: 4px;
  }
  @media (max-width: 599px) {
    .cartao {
      min-height: 0;
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      column-gap: var(--esp-4);
      row-gap: var(--esp-1);
      padding: var(--esp-5) var(--esp-4);
    }
    .cartao :global(.cartao__icone) {
      grid-row: span 2;
      margin: 0;
      width: 36px;
      height: 36px;
    }
    .cartao p {
      grid-column: 2;
      font-size: var(--texto-sm);
    }
    .cartao__avanco {
      grid-column: 3;
      grid-row: 1 / span 2;
      margin: 0;
    }
  }

  /* Destaque InnLoco */
  .destaque__grade {
    display: grid;
    gap: var(--esp-7);
    align-items: center;
  }
  .destaque__titulo {
    font-size: var(--titulo-mega);
    margin: var(--esp-5) 0 var(--esp-4);
  }
  .destaque__chamada {
    font-family: var(--fonte-display);
    font-size: var(--titulo-3);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    max-width: 22ch;
  }
  .destaque .lead {
    margin-bottom: var(--esp-6);
  }
  .destaque :global(.ficha) {
    border-image-source: var(--moldura-preta);
  }

  /* Manifesto */
  .manifesto__frase {
    font-family: var(--fonte-display);
    font-size: var(--titulo-mega);
    font-weight: 700;
    letter-spacing: var(--tracking-display);
    line-height: 1.02;
    max-width: 18ch;
    margin-bottom: var(--esp-6);
    text-wrap: balance;
  }
  .manifesto__virada {
    font-family: var(--fonte-display);
    font-size: var(--titulo-3);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0;
    color: var(--branco-quente);
  }

  /* Para quem */
  .publicos {
    margin: 0;
    border-top: 1px solid var(--cinza);
  }
  .publico {
    display: grid;
    gap: var(--esp-2);
    padding: var(--esp-5) 0;
    border-bottom: 1px solid var(--cinza);
  }
  .publico dd {
    margin: 0;
    font-family: var(--fonte-display);
    font-size: var(--titulo-3);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    max-width: 30ch;
  }

  /* Por que */
  .porque__grade {
    display: grid;
    gap: var(--esp-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }
  .porque__item {
    padding: var(--esp-3) var(--esp-2);
  }
  .porque__item h3 {
    font-size: var(--titulo-4);
    margin-bottom: var(--esp-2);
  }
  .porque__item p {
    margin: 0;
    color: var(--claro-suave);
  }

  @media (min-width: 900px) {
    .destaque__grade {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      gap: var(--esp-8);
    }
    .publico {
      grid-template-columns: 16rem 1fr;
      align-items: baseline;
      gap: var(--esp-6);
    }
    .porque {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      gap: var(--esp-7);
      align-items: start;
    }
    .porque__cabecalho {
      margin-bottom: 0;
    }
  }
</style>
